#!/usr/bin/env bash
set -euo pipefail

# `docker logs <name>` (the CLI) looks the container up via inspect first, and inspect is
# deliberately blocked by the proxy (that's the endpoint that leaks every container's env
# vars). This hits the logs endpoint directly instead, and demuxes Docker's stdout/stderr
# framing itself since the `docker` CLI isn't doing that for us here. No sudoers entry
# needed: this only talks to the proxy on 127.0.0.1, which hermes can already reach as an
# ordinary unprivileged user.

PROXY="http://127.0.0.1:2375"
API_VER="v1.53"

usage() {
  echo "usage: hermes-docker-logs <container-name> [tail-lines, default 200]" >&2
  exit 1
}

[[ $# -ge 1 && $# -le 2 ]] || usage
NAME="$1"
TAIL="${2:-200}"

# Docker's own container-name charset. Also closes off any path/query injection into the URL
# below, since NAME is interpolated directly into it.
if [[ ! "$NAME" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]]; then
  echo "hermes-docker-logs: invalid container name: $NAME" >&2
  exit 1
fi
if [[ ! "$TAIL" =~ ^[0-9]+$ ]]; then
  echo "hermes-docker-logs: tail must be a number: $TAIL" >&2
  exit 1
fi

curl -fsS "${PROXY}/${API_VER}/containers/${NAME}/logs?stdout=1&stderr=1&tail=${TAIL}&timestamps=1" \
  | python3 -c '
import sys
data = sys.stdin.buffer.read()
out = sys.stdout.buffer

# A container without an allocated tty gets its logs multiplexed: each frame is an 8-byte
# header (stream type 0/1/2, 3 reserved zero bytes, 4-byte big-endian payload length)
# followed by that many bytes of payload. A container with a tty gets plain bytes, no
# framing. We cannot ask inspect which one this is (blocked), so detect it: a real frame
# header starts with byte 0/1/2 followed by three zero bytes, which plain log text
# essentially never does by chance.
def looks_framed(buf):
    return len(buf) >= 8 and buf[0] in (0, 1, 2) and buf[1] == 0 and buf[2] == 0 and buf[3] == 0

if not looks_framed(data):
    out.write(data)
else:
    i, n = 0, len(data)
    while i + 8 <= n:
        size = int.from_bytes(data[i+4:i+8], "big")
        start = i + 8
        end = min(start + size, n)
        out.write(data[start:end])
        i = start + size
'
